<Window x:Class="BTD5ModLoader.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:ClassModifier="internal" Title="BTD5 Mod Loader"
        Width="940" Height="570" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Activated="Window_Activated"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="Transparent" AllowsTransparency="True" Foreground="#F4F7FA">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="50" CornerRadius="13" GlassFrameThickness="0"
                            ResizeBorderThickness="7" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#11171D" />
        <SolidColorBrush x:Key="TitleBrush" Color="#171E24" />
        <SolidColorBrush x:Key="PanelBrush" Color="#181F25" />
        <SolidColorBrush x:Key="RowBrush" Color="#242C32" />
        <SolidColorBrush x:Key="BorderBrush" Color="#34404A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#B6BDC3" />
        <SolidColorBrush x:Key="GreenBrush" Color="#36C326" />
        <SolidColorBrush x:Key="BlueBrush" Color="#2367A4" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="#F4F7FA" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#F5F7F8" />
        </Style>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F7F9FA" />
            <Setter Property="Background" Value="#343D45" />
            <Setter Property="BorderBrush" Value="#46525D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.42" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="#31C21C" />
            <Setter Property="BorderBrush" Value="#43D72E" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="49" />
            <Setter Property="Foreground" Value="#DDE3E7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="ImageButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OverlayCloseButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#DDE3E7" />
            <Setter Property="FontSize" Value="23" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseSurface" Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseSurface" Property="Background" Value="#2B353D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseSurface" Property="Background" Value="#583038" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F4F7FA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Background" Value="{StaticResource RowBrush}" />
            <Setter Property="BorderBrush" Value="#2E373E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Padding="7,5" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#2B353D" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource BlueBrush}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#367FBE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#11171D" />
            <Setter Property="BorderBrush" Value="#3C4852" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style x:Key="OptionsCard" TargetType="Border">
            <Setter Property="Background" Value="#1D252C" />
            <Setter Property="BorderBrush" Value="#35424C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="13" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="#3A2528" />
            <Setter Property="BorderBrush" Value="#694047" />
            <Setter Property="Foreground" Value="#FFCFD4" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowBrush}" BorderBrush="#35424C" BorderThickness="2" CornerRadius="13">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
                <RowDefinition Height="72" />
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Border Background="{StaticResource TitleBrush}" CornerRadius="11,11,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Width="35" Height="35" Source="Assets/monkey_vanilla.png" Stretch="Uniform" />
                        <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontSize="19"
                                   FontWeight="Bold" Text="BTD5 Mod Loader" />
                        <TextBlock x:Name="VersionText" Margin="9,3,0,0" VerticalAlignment="Center"
                                   Foreground="#788995" FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource ChromeButton}" Click="Minimize_Click" Content="−" />
                        <Button Style="{StaticResource ChromeButton}" Click="Maximize_Click" Content="□" />
                        <Button Style="{StaticResource ChromeButton}" Click="Close_Click" Content="×" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main three-column manager -->
            <Grid Grid.Row="1" Margin="10,0,10,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.02*" />
                    <ColumnDefinition Width="0.96*" />
                    <ColumnDefinition Width="1.08*" />
                </Grid.ColumnDefinitions>

                <Border Margin="0,0,5,0" Padding="8" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                        AllowDrop="True" DragOver="PackageDropArea_DragOver" Drop="PackageDropArea_Drop">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="3,1,3,7">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="MODS" />
                            <TextBlock x:Name="ModsSummaryText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="#82919B" FontSize="11" />
                        </Grid>
                        <ListBox x:Name="ProfilePackagesList" Grid.Row="1" Style="{StaticResource CardList}"
                                 ItemContainerStyle="{StaticResource CardItem}"
                                 SelectionChanged="PackageList_SelectionChanged"
                                 PreviewMouseRightButtonDown="ProfilePackagesList_PreviewMouseRightButtonDown">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Configure" Click="ConfigureMod_Click" />
                                    <Separator />
                                    <MenuItem Header="Move earlier" Click="MoveSelectedPackageEarlier_Click" />
                                    <MenuItem Header="Move later" Click="MoveSelectedPackageLater_Click" />
                                    <Separator />
                                    <MenuItem Header="Remove from profile"
                                              Click="RemoveSelectedPackageFromProfile_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="43" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="54" />
                                        </Grid.ColumnDefinitions>
                                        <Image Width="37" Height="37" Source="{Binding Icon}" Stretch="Uniform" />
                                        <StackPanel Grid.Column="1" Margin="5,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11"
                                                       Text="{Binding Version}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Width="44" Height="27"
                                                Style="{StaticResource ImageButton}" Click="ModToggle_Click"
                                                ToolTip="{Binding ToggleHint}">
                                            <Image Width="42" Height="25" Source="{Binding ToggleIcon}" Stretch="Fill" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button x:Name="BrowseModsFolderButton" Grid.Row="2" Margin="0,7,0,0"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource FlatButton}" Click="BrowseModsFolder_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Image Width="21" Height="21" Source="Assets/file.png" />
                                <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="Browse Mods Folder" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Margin="5" Padding="8" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="3,1,3,7">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="PROFILES" />
                            <Button HorizontalAlignment="Right" Width="28" Height="25" Padding="0"
                                    Background="Transparent" Foreground="White" BorderThickness="0"
                                    FontSize="23" Cursor="Hand" Click="CreateProfileQuick_Click"
                                    ToolTip="Create a new profile" Content="+" />
                        </Grid>
                        <ListBox x:Name="ProfilesList" Grid.Row="1" Style="{StaticResource CardList}"
                                 ItemContainerStyle="{StaticResource CardItem}"
                                 SelectionChanged="ProfilesList_SelectionChanged">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Rename profile" Click="RenameProfile_Click" />
                                    <MenuItem Header="Duplicate profile" Click="DuplicateProfile_Click" />
                                    <Separator />
                                    <MenuItem Header="Delete profile" Click="DeleteProfile_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="13" Height="13" Fill="{StaticResource GreenBrush}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11"
                                                       Text="{Binding Summary}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="2" Margin="0,7,0,0">
                            <Button Style="{StaticResource FlatButton}" Click="ImportProfile_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Image Width="19" Height="19" Source="Assets/import.png" />
                                    <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="Import Profile" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ExportProfileButton" Margin="0,5,0,0" Style="{StaticResource FlatButton}"
                                    Click="ExportProfile_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Image Width="19" Height="19" Source="Assets/export.png" />
                                    <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="Export Profile" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Margin="5,0,0,0" Padding="10" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="DETAILS" />
                        <Grid Grid.Row="1" Margin="0,11,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="54" Height="54" Background="#202930" CornerRadius="7">
                                <Image x:Name="SelectedModIcon" Margin="5" Source="Assets/monkey_modded.png" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SelectedModTitleText" FontSize="16" FontWeight="Bold"
                                           Text="Select a mod" />
                                <TextBlock x:Name="SelectedModAuthorText" Foreground="{StaticResource MutedBrush}"
                                           Text="Choose a package from the Mods panel" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="SelectedModDescriptionText" Grid.Row="2" Margin="0,2,0,10"
                                   Foreground="#D2D7DA" TextWrapping="Wrap"
                                   Text="Installed package details and profile status appear here." />
                        <TextBlock x:Name="PackageDetailsText" Grid.Row="3" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />
                        <Grid Grid.Row="4" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.78*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="1.45*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="0.78*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ConfigureModButton" Padding="6,5"
                                    Style="{StaticResource FlatButton}" Click="ConfigureMod_Click" Content="Configure" />
                            <Button x:Name="RemoveFromProfileButton" Grid.Column="2" Padding="6,5"
                                    Style="{StaticResource FlatButton}" Click="RemoveSelectedPackageFromProfile_Click"
                                    Content="Remove from profile" />
                            <Button x:Name="UninstallPackageButton" Grid.Column="4" Padding="6,5"
                                    Style="{StaticResource FlatButton}"
                                    Click="UninstallPackage_Click" Content="Uninstall" />
                        </Grid>
                        <TextBlock x:Name="StatusText" Grid.Row="5" Margin="0,7,0,0" Foreground="#8FA0AA"
                                   FontSize="11" TextWrapping="Wrap" Text="Ready" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Fixed launch footer -->
            <Border Grid.Row="2" Margin="10,0,10,10" Padding="9" Background="#182229"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="205" />
                        <ColumnDefinition Width="285" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="HealthIndicator" Width="30" Height="30" CornerRadius="15"
                                Background="{StaticResource GreenBrush}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="19"
                                       FontWeight="Bold" Text="✓" />
                        </Border>
                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="LoaderStatusText" FontSize="14" FontWeight="SemiBold"
                                       Text="Checking game…" />
                            <TextBlock x:Name="ReadinessText" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                       Text="Preparing manager state" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Margin="8,0" Style="{StaticResource FlatButton}" Click="Options_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Width="28" Height="28" Source="Assets/settings.png" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="15" Text="Options" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="LaunchModdedButton" Grid.Column="2" Style="{StaticResource GreenButton}"
                            Click="LaunchModded_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Width="30" Height="30" Source="Assets/play.png" />
                            <TextBlock x:Name="LaunchModdedText" Margin="9,0,0,0" VerticalAlignment="Center"
                                       Text="Launch BTD5" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Options overlay keeps advanced controls off the main screen. -->
            <Grid x:Name="OptionsOverlay" Grid.RowSpan="3" Visibility="Collapsed"
                  Background="#C6000000" Panel.ZIndex="20">
                <Border Margin="30,22" MaxWidth="850" Background="#141B21"
                        BorderBrush="#46545F" BorderThickness="1" CornerRadius="11">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="60" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Padding="15,0" Background="#192128" CornerRadius="10,10,0,0"
                                BorderBrush="#303C45" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Width="38" Height="38" Source="Assets/settings.png" />
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="18" FontWeight="Bold" Text="Options" />
                                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11"
                                               Text="Game setup, safe launching, diagnostics, and recovery" />
                                </StackPanel>
                                <Button Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Style="{StaticResource OverlayCloseButton}"
                                        Click="CloseOptions_Click"
                                        Content="×" ToolTip="Close options" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="13">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="221" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="9" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource OptionsCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="28" Height="28" Source="Assets/computer.png" />
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock FontSize="14" FontWeight="Bold" Text="Game &amp; loader" />
                                            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10"
                                                       Text="Installation and compatibility" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Margin="0,11,0,5" Foreground="#CAD1D6"
                                               FontSize="11" Text="BLOONS TD 5 INSTALLATION" />
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="GameDirectoryText" Style="{StaticResource DarkTextBox}"
                                                 IsReadOnly="True" ToolTip="Current Bloons TD 5 game directory" />
                                        <Button Grid.Column="1" Margin="7,0,0,0" Style="{StaticResource FlatButton}"
                                                Click="ChooseGameDirectory_Click" Content="Browse…" />
                                    </Grid>
                                    <Grid Grid.Row="3" Margin="0,10,0,0" VerticalAlignment="Bottom">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11"
                                                   Text="{Binding ElementName=LoaderStatusText, Path=Text}" />
                                        <WrapPanel Grid.Row="1" Margin="0,7,0,0">
                                            <Button x:Name="LoaderPrimaryButton" Margin="0,0,6,0"
                                                    Padding="9,5" Style="{StaticResource FlatButton}"
                                                    Click="LoaderPrimary_Click" Content="Check loader" />
                                            <Button Margin="0,0,6,0" Padding="9,5" Style="{StaticResource FlatButton}"
                                                    Click="RefreshStatus_Click" Content="Check launch" />
                                            <Button Padding="9,5" Style="{StaticResource DangerButton}"
                                                    Click="UninstallLoader_Click" Content="Uninstall" />
                                        </WrapPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource OptionsCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="28" Height="28" Source="Assets/monkey_vanilla.png" />
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock FontSize="14" FontWeight="Bold" Text="Launch &amp; support" />
                                            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10"
                                                       Text="Offline safety and troubleshooting" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border x:Name="OfflineRequirementBorder" Grid.Row="1" Margin="0,11,0,0"
                                            Padding="9" Background="#17232A"
                                            BorderBrush="#34434D" BorderThickness="1" CornerRadius="5">
                                        <StackPanel>
                                            <CheckBox x:Name="OfflineRiskCheck" Foreground="#E1E6E9"
                                                      FontWeight="SemiBold" Checked="OfflineRiskCheck_Changed"
                                                      Unchecked="OfflineRiskCheck_Changed">
                                                <TextBlock Margin="5,0,0,0" TextWrapping="Wrap"
                                                           Text="Use Steam Offline Mode for modded play" />
                                            </CheckBox>
                                            <TextBlock x:Name="OfflineRequirementHint" Margin="21,5,0,0"
                                                       Foreground="#FFBE70" FontSize="10" TextWrapping="Wrap"
                                                       Text="Required before launching with mods." />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Grid.Row="2" Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}"
                                               FontSize="10" TextWrapping="Wrap"
                                               Text="Network blocking is not implemented yet. Vanilla launch never loads a mod profile." />
                                    <Grid Grid.Row="3" Margin="0,9,0,0" VerticalAlignment="Bottom">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="LaunchVanillaButton" HorizontalAlignment="Stretch"
                                                Style="{StaticResource FlatButton}" Click="LaunchVanilla_Click">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Image Width="18" Height="18" Source="Assets/play.png" />
                                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Text="Launch vanilla" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" HorizontalAlignment="Stretch"
                                                Style="{StaticResource FlatButton}" Click="ExportDiagnostics_Click">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Image Width="18" Height="18" Source="Assets/export.png" />
                                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Text="Diagnostics" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource OptionsCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Width="23" Height="23" Source="Assets/file.png" />
                                            <StackPanel Margin="7,0,0,0">
                                                <TextBlock FontSize="13" FontWeight="Bold" Text="Runtime log" />
                                                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10"
                                                           Text="Latest messages from the in-game loader" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Ellipse x:Name="RuntimeLogLiveIndicator" Width="8" Height="8"
                                                     Fill="#37C92F" />
                                            <TextBlock x:Name="RuntimeLogLiveText" Margin="5,0,9,0"
                                                       VerticalAlignment="Center" Foreground="#7DDE79"
                                                       FontSize="10" FontWeight="Bold" Text="LIVE" />
                                            <Button Padding="9,4" Style="{StaticResource FlatButton}"
                                                    Click="RefreshLogs_Click" Content="Refresh now" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBox x:Name="RuntimeLogText" Grid.Row="1" Margin="0,8,0,0"
                                             Style="{StaticResource DarkTextBox}" IsReadOnly="True"
                                             AcceptsReturn="True" FontFamily="Consolas" FontSize="10"
                                             VerticalScrollBarVisibility="Auto" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="3" Grid.ColumnSpan="3" Margin="0,8,0,0" Padding="9,6"
                                    Background="#172027" CornerRadius="5">
                                <TextBlock Foreground="#9EADB6" FontSize="10" TextWrapping="Wrap"
                                           Text="{Binding ElementName=StatusText, Path=Text}" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Button x:Name="InstallPackageButton" Visibility="Collapsed" Click="InstallPackage_Click" />
            <Button x:Name="RenameProfileButton" Visibility="Collapsed" Click="RenameProfile_Click" />
            <Button x:Name="DuplicateProfileButton" Visibility="Collapsed" Click="DuplicateProfile_Click" />
            <Button x:Name="DeleteProfileButton" Visibility="Collapsed" Click="DeleteProfile_Click" />
        </Grid>
    </Border>
</Window>
