{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://btd5modloader.local/schemas/mod-manifest.schema.json",
  "title": "BTD5 Mod Package Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "author", "version", "entry_point", "loader_api", "supported_game_builds", "dependencies", "load_order", "capabilities"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9-]*)+$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "author": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "entry_point": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:]).+$" },
    "loader_api": { "const": 1 },
    "supported_game_builds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9-]*)+$" },
          "version": { "type": "string", "pattern": "^(?:\\*|>=|\\^)?[0-9]+\\.[0-9]+\\.[0-9]+$" }
        }
      }
    },
    "load_order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": { "before": { "$ref": "#/$defs/idList" }, "after": { "$ref": "#/$defs/idList" } }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["gameplay.events", "gameplay.mutate", "content.towers", "content.assets", "storage"] }
    },
    "configuration_defaults": { "type": "object" },
    "localization": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^localization/.+\\.json$" } },
    "documentation": { "type": "string", "maxLength": 240 }
  },
  "$defs": {
    "idList": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9-]*)+$" } }
  }
}
